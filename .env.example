# Required. Dashboard refuses to start if these are empty.
HIVE_USER=operator
HIVE_PASSWORD=change-me-now

# 1 = synthesize geolocated events (no live VLAN 7 logs required)
HIVE_DEMO=1

# Paths inside the API container (override for local `uvicorn` runs)
HIVE_DB_PATH=/data/hive.sqlite
HIVE_GEOIP_CITY=/geoip/GeoLite2-City.mmdb
HIVE_GEOIP_ASN=/geoip/GeoLite2-ASN.mmdb
HIVE_SENSORS_FILE=/app/sensors.yaml

# Event history. Older rows are purged hourly.
HIVE_RETENTION_DAYS=30
# Rail "online" means a log line or ingested event newer than this.
HIVE_SENSOR_ONLINE_MINUTES=5
HIVE_RAW_MAX_LEN=4096

# Browser origin for CORS. Same-origin via nginx does not need this;
# add every extra UI origin you actually open (Vite, LAN IP, etc.).
HIVE_CORS_ORIGIN=http://127.0.0.1:8443

# Host docker group GID so hive-api can call the Engine socket on Apply.
# getent group docker | cut -d: -f3
DOCKER_GID=127

# Optional bait-control overrides (API container paths / names)
# HIVE_OPENCANARY_CONF=/app/sensors/opencanary.conf
# HIVE_BAIT_STATE_PATH=/data/bait.json
# HIVE_DOCKER_SOCK=/var/run/docker.sock
# HIVE_COWRIE_CONTAINER=hive-cowrie
# HIVE_OPENCANARY_CONTAINER=hive-opencanary

# Public Mapbox token for the 2D/3D map (operator browser only). Do not commit a live key.
VITE_MAPBOX_TOKEN=
